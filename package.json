{
	"name": "saagar-portfolio-mcp",
	"version": "0.1.0",
	"mcpName": "io.github.saagpatel/portfolio-mcp",
	"type": "module",
	"description": "Agent-native MCP server over the public saagarpatel.dev corpus — read-only, stateless.",
	"license": "MIT",
	"author": "Saagar Patel",
	"homepage": "https://saagarpatel.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saagpatel/portfolio-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/saagpatel/portfolio-mcp/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"ai-agents",
		"portfolio",
		"bm25",
		"cloudflare-workers",
		"stdio"
	],
	"scripts": {
		"build:corpus": "node scripts/build-corpus.mjs",
		"build:cli": "esbuild src/stdio.ts --bundle --platform=node --format=esm --outfile=dist/stdio.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"probe:mcp": "node scripts/probe-mcp.mjs",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy"
	},
	"bin": {
		"saagar-portfolio-mcp": "dist/stdio.js"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.29.0",
		"zod": "^3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4",
		"esbuild": "0.28.1",
		"typescript": "^5",
		"vite": "6.4.3",
		"vitest": "3.2.6",
		"wrangler": "^4"
	}
}
